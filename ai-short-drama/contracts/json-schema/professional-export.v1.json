{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://short-drama.local/schemas/professional-export.v1.json",
  "title": "Snapshot-safe professional export request",
  "type": "object",
  "additionalProperties": false,
  "required": ["formats", "selection"],
  "properties": {
    "formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["script_docx", "script_fountain", "episode_outline", "shot_list", "contact_sheet", "subtitle_srt", "subtitle_ass", "timeline_edl", "timeline_xml", "audio_stems", "prompt_package", "production_bibles", "traceability_report"]}
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_id", "bundle_version"],
      "properties": {
        "episode_id": {"type": "string", "minLength": 1, "not": {"enum": ["current", "latest", "draft"]}},
        "bundle_version": {"type": "integer", "minimum": 1},
        "script_id": {"type": "string"},
        "storyboard_id": {"type": "string"},
        "timeline_id": {"type": "string"},
        "master_id": {"type": "string"},
        "story_bible_id": {"type": "string"},
        "source_version_id": {"type": "string"},
        "ir_revision_id": {"type": "string"},
        "adaptation_spec_version_id": {"type": "string"}
      }
    },
    "requested_by": {"type": "string"}
  }
}
