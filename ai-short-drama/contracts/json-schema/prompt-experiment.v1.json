{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://short-drama.local/schemas/prompt-experiment.v1.json",
  "title": "Frozen-suite prompt and model experiment",
  "type": "object",
  "additionalProperties": false,
  "required": ["category", "display_name", "prompt_test_suite_id", "variants"],
  "properties": {
    "category": {"enum": ["novel_analysis", "narrative_ir", "episode_planning", "script", "storyboard", "image", "video", "tts", "qc"]},
    "display_name": {"type": "string", "minLength": 1},
    "prompt_test_suite_id": {"type": "string", "minLength": 1},
    "blind_review": {"type": "boolean"},
    "created_by": {"type": "string"},
    "variants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prompt_version_id", "provider", "model", "parameters"],
        "properties": {
          "prompt_version_id": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "parameters": {"type": "object"},
          "seed": {"type": ["integer", "null"]}
        }
      }
    }
  }
}
