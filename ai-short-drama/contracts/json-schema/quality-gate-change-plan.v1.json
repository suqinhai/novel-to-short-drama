{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://short-drama.local/schemas/quality-gate-change-plan.v1.json",
  "title": "Local quality gate remediation plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "change_plan_id", "finding_id", "target", "operations", "must_preserve", "validation_codes", "downstream_rebuild", "requires_confirmation", "direct_mutation_allowed"],
  "properties": {
    "schema_version": {"const": "quality-gate-change-plan.v1"},
    "change_plan_id": {"type": "string", "minLength": 1},
    "finding_id": {"type": "string", "minLength": 1},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "artifact_id", "entity_type", "entity_id"],
      "properties": {
        "stage": {"enum": ["source_ir", "adaptation_plan", "episode_outline", "script", "storyboard", "media", "edit_timeline", "master"]},
        "artifact_id": {"type": "string", "minLength": 1}, "entity_type": {"type": "string", "minLength": 1},
        "entity_id": {"type": "string", "minLength": 1}, "field_path": {"type": "string"},
        "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 1}
      }
    },
    "operations": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["operation", "instruction"], "properties": {"operation": {"enum": ["replace", "adjust", "add_coverage", "regenerate_segment"]}, "field_path": {"type": "string"}, "instruction": {"type": "string", "minLength": 1}, "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 1}, "expected_value": {"type": "string"}}, "additionalProperties": false}},
    "must_preserve": {"type": "array", "items": {"type": "string"}},
    "validation_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "downstream_rebuild": {"type": "array", "items": {"enum": ["source_ir", "adaptation_plan", "episode_outline", "script", "storyboard", "media", "edit_timeline", "master"]}},
    "requires_confirmation": {"const": true},
    "direct_mutation_allowed": {"const": false}
  }
}
