{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-short-drama/contracts/dialogue-timing.v1.json",
  "title": "Dialogue timing and lip-sync validation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "episode_id", "items"],
  "properties": {
    "schema_version": {"const": "dialogue-timing.v1"},
    "project_id": {"$ref": "#/$defs/id"},
    "episode_id": {"$ref": "#/$defs/id"},
    "tolerance_ms": {"type": "integer", "minimum": 20, "maximum": 1000, "default": 120},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/timing"}
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 160},
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dialogue_id", "dialogue_audio_id", "shot_id", "speaker_name", "turn_index",
        "start_ms", "end_ms", "audio_duration_ms", "target_lip_start_ms",
        "target_lip_end_ms", "visible_character_ids"
      ],
      "properties": {
        "dialogue_id": {"$ref": "#/$defs/id"},
        "dialogue_audio_id": {"$ref": "#/$defs/id"},
        "shot_id": {"$ref": "#/$defs/id"},
        "speaker_character_id": {"type": "string"},
        "speaker_name": {"type": "string", "minLength": 1},
        "turn_group": {"type": "string"},
        "turn_index": {"type": "integer", "minimum": 1},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "audio_duration_ms": {"type": "integer", "minimum": 1},
        "target_lip_start_ms": {"type": "integer", "minimum": 0},
        "target_lip_end_ms": {"type": "integer", "minimum": 1},
        "visible_character_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "detected_speaker_id": {"type": "string"},
        "detected_lip_start_ms": {"type": "integer", "minimum": 0},
        "detected_lip_end_ms": {"type": "integer", "minimum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "analyzer_version": {"type": "string", "minLength": 1}
      }
    }
  }
}
