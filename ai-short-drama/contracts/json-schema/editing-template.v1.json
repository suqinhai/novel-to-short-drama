{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-short-drama/contracts/editing-template.v1.json",
  "title": "Versioned genre editing template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "template_key", "version", "average_shot_length_ms",
    "fast_cut_ratio", "reaction_shot_ratio", "transitions", "subtitle", "audio",
    "close_up_strategy", "pause_strategy", "repeat_emphasis", "beat_strategy"
  ],
  "properties": {
    "schema_version": {"const": "editing-template.v1"},
    "template_key": {"enum": ["urban_power", "emotion", "suspense", "comedy", "action"]},
    "version": {"type": "integer", "minimum": 1},
    "average_shot_length_ms": {"type": "integer", "minimum": 400, "maximum": 15000},
    "fast_cut_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "reaction_shot_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "transitions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "subtitle": {
      "type": "object",
      "required": ["style", "density"],
      "properties": {
        "style": {"type": "string"},
        "density": {"enum": ["low", "medium", "high"]}
      },
      "additionalProperties": true
    },
    "audio": {
      "type": "object",
      "required": ["bgm_density", "sfx_density"],
      "properties": {
        "bgm_density": {"type": "number", "minimum": 0, "maximum": 1},
        "sfx_density": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    },
    "close_up_strategy": {"type": "string"},
    "pause_strategy": {"type": "string"},
    "repeat_emphasis": {"type": "string"},
    "beat_strategy": {"type": "string"}
  }
}
